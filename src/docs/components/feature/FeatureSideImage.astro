---
/**
 * * These are alternating side cards with titles, text, and images
 * Recommend using 2 or 3 cards in a row
 */
import placeholderImg from "@images/placeholder.webp";

import FeatureCard from "./FeatureCardSideImage.astro";

type FeatureItem =
  | {
      image: ImageMetadata;
      title: string;
      description: string;
      buttonText?: undefined;
      href?: undefined;
    }
  | {
      image: ImageMetadata;
      title: string;
      description: string;
      buttonText: string;
      href: string;
    };

const featureData: FeatureItem[] = [
  {
    image: placeholderImg,
    title: "Git-native & Collaborative",
    description:
      "Each step is a commit: reproducible, traceable, and reviewable. Your tutorials evolve with your repo, and improvements flow in via pull requests.",
  },
  {
    image: placeholderImg,
    title: "Author Inside Your IDE",
    description:
      "Write and run tutorial code where you already work. No context switching—author, preview, and validate directly in VS Code.",
  },
  {
    image: placeholderImg,
    title: "Maintainable Over Time",
    description:
      "When code or APIs change, update steps with minimal friction. Guided conflict resolution keeps tutorials accurate without rewrites.",
  },
];
---

<section id="feature-side-image" class="my-12 overflow-hidden py-6 md:py-12">
  <div class="docs-home-container">
    <div class="flex flex-col gap-16 md:gap-24">
      {
        featureData.map((feature, idx) => (
          <FeatureCard
            title={feature.title}
            description={feature.description}
            image={feature.image}
            imageSide={idx % 2 === 0 ? "right" : "left"}
            href={feature.href}
            buttonText={feature.buttonText}
          />
        ))
      }
    </div>
  </div>
</section>

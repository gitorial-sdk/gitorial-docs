---
interface Props {
  code: string;
  title: string;
  summary: string;
  severity?: "error" | "warning";
  rationale?: string;
  validExample?: string;
  invalidExample?: string;
  anchorId?: string;
}

const {
  code,
  title,
  summary,
  severity = "error",
  rationale,
  validExample,
  invalidExample,
  anchorId,
} = Astro.props as Props;
---

<div id={anchorId || `rule-${code}`} class="rule-entry scroll-mt-20 rounded-lg border p-4">
  <header class="mb-3 flex items-start gap-2">
    <div class="flex-1">
      <h4 class="mb-1 text-base font-semibold">{title}</h4>
      <span class="text-muted-foreground text-xs">{code}</span>
    </div>
    <span
      class:list={[
        "inline-flex items-center rounded px-2 py-1 text-xs font-medium",
        severity === "error" ? "bg-error/15 text-error" : "bg-warning/15 text-warning",
      ]}
    >
      {severity.toUpperCase()}
    </span>
  </header>

  <p class="mb-2">{summary}</p>

  {rationale && <p class="text-muted-foreground mb-2 text-sm">{rationale}</p>}

  {
    (validExample || invalidExample) && (
      <div class="mt-3 grid gap-3 md:grid-cols-2">
        {validExample && (
          <div>
            <div class="text-success mb-1 text-xs font-semibold">Valid</div>
            <pre>
              <code set:html={validExample} />
            </pre>
          </div>
        )}
        {invalidExample && (
          <div>
            <div class="text-error mb-1 text-xs font-semibold">Invalid</div>
            <pre>
              <code set:html={invalidExample} />
            </pre>
          </div>
        )}
      </div>
    )
  }
</div>

<style is:global>
  @import "tailwindcss/theme" theme(reference);
  @import "@/styles/tailwind-theme.css" theme(reference);

  .rule-entry pre {
    @apply bg-background rounded-md border p-3 text-xs;
  }
</style>

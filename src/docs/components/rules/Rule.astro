---
interface Props {
  code: string;
  title: string;
  summary: string;
  severity?: "error" | "warning";
  rationale?: string;
  validExample?: string;
  invalidExample?: string;
  anchorId?: string;
}

const {
  code,
  title,
  summary,
  severity = "error",
  rationale,
  validExample,
  invalidExample,
  anchorId,
} = Astro.props as Props;
---

<div id={anchorId || `rule-${code}`} class="rule-entry scroll-mt-20 rounded-lg border p-4">
  <header class="mb-3 flex items-start gap-2">
    <div class="flex-1">
      <h4 class="mb-1 text-base font-semibold">{title}</h4>
      <span class="text-xs text-muted-foreground">{code}</span>
    </div>
    <span class:list={[
      "inline-flex items-center rounded px-2 py-1 text-xs font-medium",
      severity === "error" ? "bg-error/15 text-error" : "bg-warning/15 text-warning",
    ]}>
      {severity.toUpperCase()}
    </span>
  </header>

  <p class="mb-2">{summary}</p>

  {rationale && (
    <p class="mb-2 text-sm text-muted-foreground">{rationale}</p>
  )}

  {(validExample || invalidExample) && (
    <div class="mt-3 grid gap-3 md:grid-cols-2">
      {validExample && (
        <div>
          <div class="mb-1 text-xs font-semibold text-success">Valid</div>
          <pre><code set:html={validExample}></code></pre>
        </div>
      )}
      {invalidExample && (
        <div>
          <div class="mb-1 text-xs font-semibold text-error">Invalid</div>
          <pre><code set:html={invalidExample}></code></pre>
        </div>
      )}
    </div>
  )}
</div>

<style is:global>
  @import "tailwindcss/theme" theme(reference);
  @import "@/styles/tailwind-theme.css" theme(reference);

  .rule-entry pre {
    @apply rounded-md border bg-background p-3 text-xs;
  }
</style>



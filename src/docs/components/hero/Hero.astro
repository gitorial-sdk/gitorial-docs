---
import Button from "@/docs/components/button/Button.astro";
import { docsRoute } from "@/docs/js/docsUtils";
import { getLocaleFromUrl } from "@/docs/js/localeUtils";
import { getLocalizedRoute, getTranslatedData, useTranslations } from "@/docs/js/translationUtils";
const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);
const t = useTranslations(currLocale);
---

<div class="relative" id="hero">
  <div
    id="main-content"
    class="docs-home-container relative flex min-h-[40lvh] items-center justify-center overflow-clip py-16 md:min-h-[60lvh] md:py-40"
  >
    <!-- background elements -->
    <div
      class="pointer-events-none absolute inset-x-0 inset-y-0 m-auto overflow-clip lg:inset-x-4 lg:rounded-b-[4rem]"
      aria-hidden="true"
    >
      <div class="relative h-full w-full">
        <!-- particles canvas -->
        <canvas
          data-particle-animation
          data-particle-quantity="30"
          data-particle-staticity="70"
          data-particle-ease="70"
          data-particle-max-size="3"></canvas>
        <!-- Decorative bottom glow -->
        <div
          aria-hidden="true"
          class="hero-bottom-glow pointer-events-none absolute inset-0 -z-10 overflow-clip blur-3xl"
        >
        </div>
      </div>
    </div>

    <!-- main hero section -->
    <div class="relative z-10 max-w-[800px] px-2 pb-10 text-center">
      <div class="mb-6" data-mos="fade-down" data-mos-anchor="#main-content" data-mos-delay="50">
        <span
          class="bg-primary/10 text-primary border-primary/20 inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
            <path
              d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
            ></path>
          </svg>
          Interactive Coding Tutorials
        </span>
      </div>
      <div class="flex justify-center">
        <h1
          data-mos="fade-down"
          data-mos-anchor="#main-content"
          class="from-foreground/60 font-heading via-foreground/70 to-foreground/90 mx-auto mb-5 bg-gradient-to-b bg-clip-text pb-2 text-4xl leading-12 font-medium sm:text-6xl md:leading-15 lg:text-7xl dark:text-transparent"
        >
          Gitorial SDK
        </h1>
      </div>
      <p
        class="text-muted-foreground mx-auto mb-8 max-w-2xl text-lg leading-relaxed sm:text-xl md:text-2xl"
        data-mos="fade-down"
        data-mos-anchor="#main-content"
        data-mos-delay="150"
      >
        Build interactive coding tutorials directly from your git repositories.
        <span class="text-foreground font-semibold">Version-controlled.</span>
        <span class="text-foreground font-semibold">Collaborative.</span>
        <span class="text-foreground font-semibold">Scalable.</span>
      </p>

      <!-- Feature Highlights -->
      <div
        class="mb-10 grid grid-cols-1 gap-4 sm:grid-cols-3"
        data-mos="fade-down"
        data-mos-anchor="#main-content"
        data-mos-delay="200"
      >
        <div class="text-muted-foreground flex items-center justify-center gap-2 text-sm">
          <svg class="h-5 w-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
              clip-rule="evenodd"></path>
          </svg>
          Git-based Tutorials
        </div>
        <div class="text-muted-foreground flex items-center justify-center gap-2 text-sm">
          <svg class="h-5 w-5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
            <path
              d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3z"
            ></path>
          </svg>
          Real-time Collaboration
        </div>
        <div class="text-muted-foreground flex items-center justify-center gap-2 text-sm">
          <svg class="h-5 w-5 text-purple-500" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.4-1.561 2.6 0 2.958a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287-1.947c1.561-.4 1.561-2.6 0-2.958a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z"
              clip-rule="evenodd"></path>
          </svg>
          Version Control
        </div>
      </div>

      <!-- Call to Action Buttons -->
      <div
        class="flex flex-col gap-4 sm:flex-row sm:justify-center"
        data-mos="fade-down"
        data-mos-anchor="#main-content"
        data-mos-delay="300"
      >
        <Button
          href={`/${docsRoute}/getting-started`}
          variant="primary"
          size="lg"
          class="group relative overflow-hidden"
        >
          <svg
            class="mr-2 h-5 w-5 transition-transform group-hover:translate-x-0.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
          Get Started
        </Button>
        <Button href={`/${docsRoute}/components`} variant="outline" size="lg" class="group">
          <svg
            class="mr-2 h-5 w-5 transition-transform group-hover:scale-110"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
          View Spec
        </Button>
      </div>

      <!-- GitHub Stats or Additional Info -->
      <div
        class="text-muted-foreground mt-8 flex items-center justify-center gap-6 text-sm"
        data-mos="fade-up"
        data-mos-anchor="#main-content"
        data-mos-delay="400"
      >
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          Open Source
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
              clip-rule="evenodd"></path>
          </svg>
          MIT License
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* U-shaped bottom glow behind hero */
  .hero-bottom-glow {
    background: radial-gradient(
      100% 100% at 50% 20%,
      transparent 0%,
      transparent 50%,
      var(--color-accent) 80%
    );
    animation: pulse 4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 0.6;
    }
  }

  /* Gradient text animation */
  .bg-gradient-to-r {
    background-size: 200% 100%;
    animation: gradient-shift 3s ease-in-out infinite;
  }

  @keyframes gradient-shift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
</style>
